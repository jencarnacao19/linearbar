<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>LinearBar</RootNamespace>
    <AssemblyName>LinearBar</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\LinearBar.ico</ApplicationIcon>
    <!-- Only ship the neutral resources of dependencies. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ManagedShell (Apache-2.0, the engine behind RetroBar) provides the hard Win32 parts:
      AppBar registration, the task list (shell hook), notification-area icons and hiding
      the Explorer taskbar.
    -->
    <PackageReference Include="ManagedShell" Version="0.0.374" />
  </ItemGroup>

  <ItemGroup>
    <!-- Script plugins shipped with the app, copied to "plugins" next to LinearBar.exe. -->
    <None Include="..\..\plugins\**\*" LinkBase="plugins" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinearBar.Core\LinearBar.Core.csproj" />
  </ItemGroup>

</Project>
