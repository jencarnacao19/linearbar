<appbar:AppBarWindow x:Class="LinearBar.BarWindow"
                     x:ClassModifier="internal"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:appbar="clr-namespace:ManagedShell.AppBar;assembly=ManagedShell.AppBar"
                     xmlns:local="clr-namespace:LinearBar"
                     xmlns:dock="clr-namespace:LinearBar.Dock"
                     xmlns:widgets="clr-namespace:LinearBar.Widgets"
                     xmlns:visuals="clr-namespace:LinearBar.Visuals"
                     Title="LinearBar"
                     AllowsTransparency="True"
                     Background="Transparent"
                     ShowActivated="False"
                     SnapsToDevicePixels="True"
                     FontFamily="{StaticResource UiFont}">

    <!--
        The window is taller than the bar: only the strip at the bottom is reserved screen
        space, the rest is a transparent, click-through band that magnified dock icons and
        their labels grow into. See BarWindow.xaml.cs.
    -->

    <appbar:AppBarWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>

        <!-- A notification-area icon. Mouse input is forwarded to the app that owns it. -->
        <DataTemplate x:Key="TrayIconTemplate">
            <visuals:SquircleBorder Width="28"
                                    Height="32"
                                    Radius="10"
                                    ToolTip="{Binding Title}"
                                    MouseDown="OnTrayIconMouseDown"
                                    MouseUp="OnTrayIconMouseUp"
                                    MouseEnter="OnTrayIconMouseEnter"
                                    MouseLeave="OnTrayIconMouseLeave"
                                    MouseMove="OnTrayIconMouseMove">
                <visuals:SquircleBorder.Style>
                    <Style TargetType="visuals:SquircleBorder">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </visuals:SquircleBorder.Style>
                <Image Width="16"
                       Height="16"
                       Source="{Binding Icon}"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </visuals:SquircleBorder>
        </DataTemplate>

        <!-- A plugin widget: icon, text, gauges or a small graph. Everything is a squircle. -->
        <DataTemplate x:Key="PluginTemplate">
            <Button Style="{StaticResource BarButton}"
                    Padding="8,0"
                    Click="OnPluginClick"
                    MouseRightButtonUp="OnPluginRightClick"
                    ToolTip="{Binding Tooltip}"
                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Grid VerticalAlignment="Center">
                        <visuals:IconView Width="18"
                                          Height="18"
                                          Icon="{Binding Icon}"
                                          Image="{Binding Image}"
                                          Brush="{Binding Accent}" />
                        <visuals:SquircleBorder Width="7"
                                                Height="7"
                                                Margin="0,-2,-3,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="{StaticResource AttentionBrush}"
                                                Radius="3.5"
                                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12.5"
                                   Text="{Binding Text}"
                                   Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl Focusable="False"
                                      ItemsSource="{Binding Bars}"
                                      Visibility="{Binding HasBars, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <visuals:PillGauge Width="48"
                                                       Height="3.5"
                                                       Margin="0,3,0,0"
                                                       Value="{Binding Value}"
                                                       Fill="{Binding Fill}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <widgets:SparklineControl Width="34"
                                              Height="18"
                                              Margin="7,0,0,0"
                                              VerticalAlignment="Center"
                                              History="{Binding Graph}"
                                              Maximum="{Binding GraphMaximum}"
                                              Version="{Binding GraphVersion}"
                                              Stroke="{Binding Accent}"
                                              Visibility="{Binding HasGraph, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- A live graph: caption and value on top, sparkline below. -->
        <DataTemplate x:Key="MetricTemplate">
            <Button Style="{StaticResource BarButton}"
                    Padding="7,0"
                    Command="{Binding DataContext.TaskManagerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="{Binding Detail}">
                <Grid Width="{Binding Width}" Height="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               FontSize="9.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SubtleTextBrush}"
                               Text="{Binding Label}" />
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               FontSize="10.5"
                               Foreground="{StaticResource TextBrush}"
                               Text="{Binding ValueText}" />
                    <widgets:SparklineControl Grid.Row="1"
                                              Margin="0,2,0,0"
                                              History="{Binding History}"
                                              SecondaryHistory="{Binding SecondaryHistory}"
                                              Maximum="{Binding Maximum}"
                                              Version="{Binding Version}"
                                              Stroke="{Binding Stroke}"
                                              Fill="{Binding Fill}"
                                              SecondaryStroke="{Binding SecondaryStroke}" />
                </Grid>
            </Button>
        </DataTemplate>
    </appbar:AppBarWindow.Resources>

    <Grid>
        <!--
            The reserved strip. It is transparent apart from the floating glass islands, but
            keeps an invisible (alpha 1) background so clicks between the islands still reach
            the bar (for its context menu) instead of falling through to the desktop.
        -->
        <Border x:Name="Strip"
                Height="{Binding BarHeight}"
                VerticalAlignment="Bottom"
                Background="#01000000">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{x:Static local:Strings.TaskManager}" Command="{Binding TaskManagerCommand}" />
                    <Separator />
                    <MenuItem Header="{x:Static local:Strings.OpenSettings}" Command="{Binding OpenSettingsCommand}" />
                    <MenuItem Header="{x:Static local:Strings.OpenLog}" Command="{Binding OpenLogCommand}" />
                    <Separator />
                    <MenuItem Header="{x:Static local:Strings.Exit}" Command="{Binding ExitCommand}" />
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- Left: Start. -->
                <visuals:GlassPanel x:Name="LeftGroup"
                                    Margin="5,0,0,0"
                                    Height="{Binding IslandHeight}"
                                    Radius="{Binding IslandRadius}"
                                    Padding="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    SizeChanged="OnSideGroupSizeChanged">
                    <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BarButton}"
                            Width="{Binding StartButtonSize}"
                            Margin="0"
                            Padding="0"
                            Command="{Binding StartCommand}"
                            MouseRightButtonUp="OnStartRightClick"
                            ToolTip="{x:Static local:Strings.Start}">
                        <visuals:StartGlyph Width="18" Height="18" Fill="{StaticResource AccentBrush}" />
                    </Button>
                    <ItemsControl Focusable="False"
                                  ItemTemplate="{StaticResource PluginTemplate}"
                                  ItemsPanel="{StaticResource HorizontalPanel}"
                                  ItemsSource="{Binding Plugins.Left}" />
                    </StackPanel>
                </visuals:GlassPanel>

                <!-- Right: graphs, battery, tray, clock. -->
                <visuals:GlassPanel x:Name="RightGroup"
                                    Margin="0,0,5,0"
                                    Height="{Binding IslandHeight}"
                                    Radius="{Binding IslandRadius}"
                                    Padding="6,3,6,3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    SizeChanged="OnSideGroupSizeChanged">
                <StackPanel Orientation="Horizontal">

                    <ItemsControl Focusable="False"
                                  ItemTemplate="{StaticResource PluginTemplate}"
                                  ItemsPanel="{StaticResource HorizontalPanel}"
                                  ItemsSource="{Binding Plugins.Right}" />

                    <ItemsControl Focusable="False"
                                  ItemTemplate="{StaticResource MetricTemplate}"
                                  ItemsPanel="{StaticResource HorizontalPanel}"
                                  ItemsSource="{Binding Metrics.Items}" />

                    <Button Style="{StaticResource BarButton}"
                            Command="{Binding TaskManagerCommand}"
                            ToolTip="{Binding Metrics.BatteryDetail}"
                            Visibility="{Binding Metrics.ShowBattery, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="20" Height="10" Margin="0,1,6,0" VerticalAlignment="Center">
                                <Border Margin="0,0,2,0"
                                        BorderBrush="{StaticResource TextBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2" />
                                <Border Width="2"
                                        Height="4"
                                        HorizontalAlignment="Right"
                                        Background="{StaticResource TextBrush}" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="12"
                                       Text="{Binding Metrics.BatteryText}" />
                        </StackPanel>
                    </Button>

                    <StackPanel Margin="4,0,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding ShowTray, Converter={StaticResource BoolToVisibility}}">
                        <ToggleButton Style="{StaticResource BarToggleButton}"
                                      Width="22"
                                      IsChecked="{Binding IsTrayExpanded}"
                                      ToolTip="{x:Static local:Strings.ShowHiddenIcons}">
                            <Path Width="9"
                                  Height="5"
                                  Data="M0,5 L4.5,0.5 L9,5"
                                  Stretch="Fill"
                                  Stroke="{StaticResource SubtleTextBrush}"
                                  StrokeEndLineCap="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeThickness="1.4" />
                        </ToggleButton>
                        <ItemsControl VerticalAlignment="Center"
                                      Focusable="False"
                                      ItemTemplate="{StaticResource TrayIconTemplate}"
                                      ItemsPanel="{StaticResource HorizontalPanel}"
                                      ItemsSource="{Binding UnpinnedTrayIcons}"
                                      Visibility="{Binding IsTrayExpanded, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl VerticalAlignment="Center"
                                      Focusable="False"
                                      ItemTemplate="{StaticResource TrayIconTemplate}"
                                      ItemsPanel="{StaticResource HorizontalPanel}"
                                      ItemsSource="{Binding PinnedTrayIcons}" />
                    </StackPanel>

                    <Button Style="{StaticResource BarButton}"
                            Margin="4,4,1,4"
                            Command="{Binding NotificationCenterCommand}"
                            ToolTip="{Binding Clock.FullDate}"
                            Visibility="{Binding Clock.IsVisible, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="12.5"
                                       Text="{Binding Clock.TimeText}" />
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="10.5"
                                       Foreground="{StaticResource SubtleTextBrush}"
                                       Text="{Binding Clock.DateText}"
                                       Visibility="{Binding Clock.ShowDate, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </visuals:GlassPanel>
            </Grid>
        </Border>

        <!-- The dock spans the whole window so its icons can grow above the strip. -->
        <dock:DockView x:Name="DockHost" DataContext="{Binding Dock}" />
    </Grid>
</appbar:AppBarWindow>
