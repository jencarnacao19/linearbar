<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:visuals="clr-namespace:LinearBar.Visuals">

    <!-- Palette. Graph colours live in Palette.cs because view models hand out the brushes. -->
    <SolidColorBrush x:Key="BarBorderBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F5" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A8A8B4" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5AA9FF" />
    <SolidColorBrush x:Key="AttentionBrush" Color="#FFB454" />
    <SolidColorBrush x:Key="IndicatorBrush" Color="#B4FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#1AFFFFFF" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!--
        Every surface is a squircle (continuous corners): buttons, toggles, menus, tooltips,
        gauges, pop-ups. See Visuals/SquircleBorder and Visuals/GlassPanel.
    -->

    <Style x:Key="BarButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="1,3" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="450" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <visuals:SquircleBorder x:Name="Chrome"
                                            Background="{TemplateBinding Background}"
                                            Radius="13"
                                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </visuals:SquircleBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A filled squircle chip, used for the buttons in plugin panels. -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Margin" Value="3" />
    </Style>

    <Style x:Key="BarToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="1,3" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <visuals:SquircleBorder x:Name="Chrome" Background="{TemplateBinding Background}" Radius="11">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </visuals:SquircleBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dock cells have no chrome of their own: the magnification is the hover feedback. -->
    <Style x:Key="DockItemButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter x:Name="Content" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Content" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin squircle-pill progress bar drawn over the bottom of a dock icon. -->
    <Style x:Key="DockProgressBar" TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <visuals:SquircleBorder x:Name="PART_Track" Background="#99000000" Radius="2" />
                        <visuals:SquircleBorder x:Name="PART_Indicator"
                                                HorizontalAlignment="Left"
                                                Background="{TemplateBinding Foreground}"
                                                Radius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pop-ups: opaque squircle glass (no blur reaches them). -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6,10,7" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <visuals:GlassPanel Solid="True" Radius="10" Padding="{TemplateBinding Padding}" Margin="4">
                        <ContentPresenter />
                    </visuals:GlassPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <visuals:GlassPanel Solid="True" Radius="14" Padding="5" Margin="4">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </visuals:GlassPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="12,7,26,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <visuals:SquircleBorder x:Name="Chrome"
                                            Background="Transparent"
                                            Radius="9"
                                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </visuals:SquircleBorder>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Margin" Value="10,4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <visuals:SquircleBorder Height="1" Background="{StaticResource SeparatorBrush}" Radius="0.5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
