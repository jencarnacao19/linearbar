<UserControl x:Class="LinearBar.Dock.DockView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LinearBar.Dock"
             xmlns:infra="clr-namespace:LinearBar.Infrastructure"
             xmlns:visuals="clr-namespace:LinearBar.Visuals"
             Focusable="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:MinimumToVisibilityConverter x:Key="MinimumToVisibility" />
    </UserControl.Resources>

    <Grid>
        <!--
            The panel fills the whole window (bar strip plus the transparent band above it)
            and positions the cells itself; see MagnifyPanel.
        -->
        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" IsTabStop="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:MagnifyPanel Loaded="OnPanelLoaded"
                                        SlotWidth="{Binding SlotWidth}"
                                        CellHeight="{Binding CellHeight}"
                                        BottomMargin="{Binding CellBottomMargin}"
                                        MaxScale="{Binding MaxScale}"
                                        LensRadius="{Binding LensRadius}"
                                        PlatterHeight="{Binding PlatterHeight}"
                                        PlatterBottom="{Binding PlatterBottom}"
                                        PlatterRadius="{Binding PlatterRadius}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- One cell: the icon with the running indicator underneath. -->
                    <Button Style="{StaticResource DockItemButton}"
                            Width="{Binding DataContext.SlotWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Height="{Binding DataContext.CellHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Command="{Binding ClickCommand}"
                            PreviewMouseLeftButtonDown="OnItemPressed"
                            MouseDown="OnItemMouseDown"
                            ContextMenuOpening="OnItemContextMenuOpening">
                        <Button.ContextMenu>
                            <!-- Filled on demand in OnItemContextMenuOpening. -->
                            <ContextMenu />
                        </Button.ContextMenu>

                        <Grid>
                            <visuals:IconTile x:Name="Icon"
                                              Icon="{Binding Icon}"
                                              Tint="{Binding TileTint}"
                                              ShowTile="{Binding DataContext.IconTiles, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Top" />

                            <ProgressBar Style="{StaticResource DockProgressBar}"
                                         Margin="5,0,5,9"
                                         VerticalAlignment="Bottom"
                                         Value="{Binding Progress, Mode=OneWay}"
                                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                         Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}"
                                         x:Name="ProgressIndicator" />

                            <!-- Running indicator: one dot per window, up to three. -->
                            <StackPanel Height="4"
                                        Margin="0,0,0,1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Orientation="Horizontal">
                                <Border x:Name="Dot1" Width="4" Height="4" Margin="1.5,0" CornerRadius="2"
                                        Background="{StaticResource IndicatorBrush}"
                                        Visibility="{Binding IndicatorCount, Converter={StaticResource MinimumToVisibility}, ConverterParameter=1}" />
                                <Border x:Name="Dot2" Width="4" Height="4" Margin="1.5,0" CornerRadius="2"
                                        Background="{StaticResource IndicatorBrush}"
                                        Visibility="{Binding IndicatorCount, Converter={StaticResource MinimumToVisibility}, ConverterParameter=2}" />
                                <Border x:Name="Dot3" Width="4" Height="4" Margin="1.5,0" CornerRadius="2"
                                        Background="{StaticResource IndicatorBrush}"
                                        Visibility="{Binding IndicatorCount, Converter={StaticResource MinimumToVisibility}, ConverterParameter=3}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <DataTemplate.Triggers>
                        <!-- The app in front gets a wider, accent-coloured indicator. -->
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="Dot1" Property="Width" Value="12" />
                            <Setter TargetName="Dot1" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Dot2" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Dot3" Property="Background" Value="{StaticResource AccentBrush}" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding IsProgressError}" Value="True">
                            <Setter TargetName="ProgressIndicator" Property="Foreground" Value="{StaticResource AttentionBrush}" />
                        </DataTrigger>

                        <!-- A window asking for attention pulses its icon. -->
                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                            <Setter TargetName="Dot1" Property="Background" Value="{StaticResource AttentionBrush}" />
                            <Setter TargetName="Dot2" Property="Background" Value="{StaticResource AttentionBrush}" />
                            <Setter TargetName="Dot3" Property="Background" Value="{StaticResource AttentionBrush}" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="AttentionPulse">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Icon"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.4" Duration="0:0:0.55"
                                                         AutoReverse="True" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="AttentionPulse" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- App name above the hovered icon. A Canvas so the label can be placed freely. -->
        <Canvas IsHitTestVisible="False">
            <visuals:GlassPanel x:Name="Label"
                                Padding="11,4,11,5"
                                Radius="10"
                                Visibility="Collapsed">
                <visuals:GlassPanel.RenderTransform>
                    <TranslateTransform x:Name="LabelOffset" />
                </visuals:GlassPanel.RenderTransform>
                <TextBlock x:Name="LabelText"
                           FontFamily="{StaticResource UiFont}"
                           FontSize="12.5"
                           Foreground="{StaticResource TextBrush}" />
            </visuals:GlassPanel>
        </Canvas>
    </Grid>
</UserControl>
