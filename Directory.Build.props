<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the WPF project compile on Linux/macOS (CI, cloud agents). No effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.1.0</Version>
    <Product>LinearBar</Product>
    <Authors>LinearBar</Authors>
  </PropertyGroup>
</Project>
